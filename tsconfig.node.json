{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts","src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/database/logic/*.ts"],
  "exclude": ["src/renderer/**/*.test.ts"]
}
